---
// Das taupefarbene horizontale Band aus dem Logo – als Trenner (leer) oder mit Inhalt (Slot).
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const hasContent = Astro.slots.has('default');
---

{
  hasContent ? (
    <div class:list={['bg-taupe text-bg', className]}>
      <div class="container-page py-3 text-center text-sm tracking-[0.22em]">
        <slot />
      </div>
    </div>
  ) : (
    <div class:list={['h-3 bg-taupe md:h-4', className]} role="presentation" />
  )
}
