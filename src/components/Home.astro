---
// Gemeinsamer Inhalt der Startseite für TR (/) und EN (/en/)
import BaseLayout from '../layouts/BaseLayout.astro';
import About from './About.astro';
import Band from './Band.astro';
import BeforeAfter from './BeforeAfter.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import Gallery from './Gallery.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Packages from './Packages.astro';
import Process from './Process.astro';
import Services from './Services.astro';
import { SITE, instagramUrl } from '../config/site';
import { getLangFromUrl, localizedPath, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const url = new URL(localizedPath('/', lang), Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${new URL('/', Astro.site).href}#business`,
  name: SITE.name,
  description: t('meta.description'),
  url,
  inLanguage: lang,
  image: new URL(SITE.ogImage, Astro.site).href,
  telephone: `+${SITE.whatsapp}`,
  email: SITE.email,
  founder: { '@type': 'Person', name: SITE.owner, jobTitle: lang === 'tr' ? 'İç Mimar' : 'Interior Designer' },
  areaServed: [
    { '@type': 'Country', name: 'Türkiye' },
    { '@type': 'Place', name: lang === 'tr' ? 'Kuzey Kıbrıs Türk Cumhuriyeti (KKTC)' : 'Northern Cyprus' },
    // Online-Pakete auch für Kund:innen im Ausland
    lang === 'tr' ? 'Dünya geneli (online)' : 'Worldwide (online)',
  ],
  address: [
    { '@type': 'PostalAddress', addressLocality: 'Lefkoşa', addressRegion: lang === 'tr' ? 'KKTC' : 'Northern Cyprus' },
    { '@type': 'PostalAddress', addressLocality: 'Bornova', addressRegion: 'İzmir', addressCountry: 'TR' },
  ],
  sameAs: [instagramUrl],
};
---

<BaseLayout>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(jsonLd)} />

  <Header />
  <main id="main">
    <Hero />
    <Services />
    <BeforeAfter />
    <Packages />
    <Gallery />
    <Process />
    <About />
    <Band />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
