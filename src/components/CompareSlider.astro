---
// Vorher/Nachher-Slider: links 3D-Render, rechts echtes Foto. Bedienbar per Maus, Touch und Tastatur (natives range-Input).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  render: ImageMetadata;
  real: ImageMetadata;
  /** Kurzbezeichnung des Motivs, z. B. „Lobi / bekleme alanı" */
  label: string;
  loading?: 'lazy' | 'eager';
}

const { render, real, label, loading = 'lazy' } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
const sizes = `(min-width: ${render.width + 40}px) ${render.width}px, 92vw`;
---

<div
  class="compare relative mx-auto w-full select-none overflow-hidden rounded-2xl bg-surface"
  style={`--pos: 50%; max-width: ${render.width}px; aspect-ratio: ${render.width} / ${render.height}`}
  data-compare
>
  <Image
    src={real}
    alt={`${label} – ${t('compare.real')}`}
    widths={[400, real.width]}
    sizes={sizes}
    loading={loading}
    class="absolute inset-0 size-full object-cover"
  />
  <div class="compare-clip absolute inset-0">
    <Image
      src={render}
      alt={`${label} – ${t('compare.render')}`}
      widths={[400, render.width]}
      sizes={sizes}
      loading={loading}
      class="absolute inset-0 size-full object-cover"
    />
  </div>

  <span class="compare-tag left-3">{t('compare.render')}</span>
  <span class="compare-tag right-3">{t('compare.real')}</span>

  <div class="compare-handle" aria-hidden="true">
    <span class="compare-knob">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m9 7-5 5 5 5M15 7l5 5-5 5"></path>
      </svg>
    </span>
  </div>

  <input
    type="range"
    min="0"
    max="100"
    value="50"
    step="1"
    aria-label={t('compare.sliderAria', { name: label })}
    class="compare-range"
  />
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-compare]').forEach((slider) => {
    const range = slider.querySelector<HTMLInputElement>('input[type="range"]');
    if (!range) return;
    const sync = () => slider.style.setProperty('--pos', `${range.value}%`);
    range.addEventListener('input', sync);
    sync();
  });
</script>

<style>
  .compare-clip {
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  .compare-tag {
    position: absolute;
    top: 0.75rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background-color: rgb(43 40 38 / 0.78);
    color: var(--bg);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    pointer-events: none;
  }

  .compare-handle {
    position: absolute;
    inset-block: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background-color: var(--bg);
    box-shadow: 0 0 0 1px rgb(43 40 38 / 0.15);
    pointer-events: none;
  }

  .compare-knob {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border-radius: 999px;
    background-color: var(--bg);
    color: var(--ink);
    box-shadow: 0 2px 10px rgb(43 40 38 / 0.35);
    transform: translate(-50%, -50%);
  }

  /* Unsichtbares, aber voll bedienbares Range-Input über dem gesamten Bild */
  .compare-range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    touch-action: pan-y;
  }

  .compare:has(.compare-range:focus-visible) {
    outline: 3px solid var(--wood);
    outline-offset: 3px;
  }
</style>
